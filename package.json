{
  "name": "db-less-rag-s3-files",
  "version": "1.0.0",
  "private": true,
  "description": "Grepping PDF question answering with S3 Files, ripgrep, and provider-agnostic LangChain LLMs.",
  "scripts": {
    "build": "sam build",
    "sam:validate": "sam validate",
    "sam:deploy": "sam deploy",
    "frontend:config": "bash scripts/update-frontend-config.sh",
    "deploy": "npm run sam:validate && npm run build && npm run sam:deploy && npm run frontend:config",
    "destroy": "bash scripts/destroy.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"frontend/js/*.js\" \"scripts/*.mjs\" \"*.{mjs,json,yaml,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"frontend/js/*.js\" \"scripts/*.mjs\" \"*.{mjs,json,yaml,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "frontend:dev": "node scripts/serve-frontend.mjs"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.34.0",
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/client-secrets-manager": "^3.879.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "@langchain/anthropic": "^0.3.16",
    "@langchain/aws": "^0.1.8",
    "@langchain/core": "^0.3.72",
    "@langchain/openai": "^0.3.17",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.21",
    "@types/pdf-parse": "^1.1.4",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0"
  }
}
